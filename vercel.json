    "api/grade.ts": {
      "maxDuration": 20
    },
    "api/song-lyrics.ts": {
      "maxDuration": 90
    },
    "api/song.ts": {
      "maxDuration": 60
    },
    "api/solve-tools.ts": {
      "maxDuration": 90
    },
    "api/cards.ts": {
      "maxDuration": 180
    },
    "api/solve.ts": {
      "maxDuration": 90
    },
    "api/lesson.ts": {
      "maxDuration": 300
    },
    "api/account.ts": {
      "maxDuration": 60
    }
  }
}
